# 微信小程序项目 .gitignore 文件

# 编译生成的文件
/dist/
/build/


# 微信小程序临时文件
/.temp/
/.idea/
/.vscode/
/.cache/
/.webpack/
/.babelrc
/.eslintrc.js
/.eslintignore
/.prettierrc
/.prettierignore

# 节点模块
/node_modules/

# 本地配置文件
/.env
/.env.local
/.env.development
/.env.production

# 日志文件
/*.log

# 临时文件
*~

# DS_Store 文件（MacOS）
/.DS_Store

# Thumbs.db 文件（Windows）
/Thumbs.db

# 自定义配置文件
/config.local.json

# 微信小程序云开发相关文件
/cloudfunctions/**/node_modules/
/cloudfunctions/**/.npm/
/cloudfunctions/**/.nvmrc
/cloudfunctions/**/.env
/cloudfunctions/**/.env.local
/cloudfunctions/**/.env.development
/cloudfunctions/**/.env.production

# 微信小程序插件相关文件
/plugins/**/node_modules/
/plugins/**/.npm/
/plugins/**/.nvmrc
/plugins/**/.env
/plugins/**/.env.local
/plugins/**/.env.development
/plugins/**/.env.production

# 微信小程序第三方库
/lib/**/node_modules/
/lib/**/.npm/
/lib/**/.nvmrc
/lib/**/.env
/lib/**/.env.local
/lib/**/.env.development
/lib/**/.env.production